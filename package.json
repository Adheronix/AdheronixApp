{
  "name": "medisafe-app",
  "version": "1.0.0",
  "scripts": {
    "start": "npm run start --workspace=mobile-api",
    "dev": "concurrently \"npm run start:dev --workspace=backend-api\" \"npm run start --workspace=mobile-api\"",
    "backend": "npm run start:dev --workspace=backend-api",
    "mobile": "npm run start --workspace=mobile-api",
    "set-ip": "bash mobile-api/set-local-ip.sh"
  },
  "private": true,
  "workspaces": [
    "backend-api",
    "mobile-api"
  ],
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
