# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=adheronix
DB_SSL=false
DB_MAINTENANCE_NAME=postgres

# JWT Auth
JWT_SECRET=change-me-to-a-secure-random-string
ADMIN_SETUP_KEY=change-me

# OpenRouter API
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=AdheronixApp

# Model Configuration - Core D (Orchestrator)
MINIMAX_MODEL=minimax/minimax-m2.5:free

# Model Configuration - Core A (Medical Reasoning)
HERMES_MODEL=nousresearch/hermes-3-llama-3.1-405b:free

# Model Configuration - Core B (Action Executor)
QWEN_CODER_MODEL=qwen/qwen3-coder-480b-a35b-instruct:free

# Model Configuration - Core C (Fast Response)
LLAMA_FAST_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Model Configuration - Core E (Kinyarwanda/French)
QWEN_KINYARWANDA_MODEL=qwen/qwen3-next-80b-a3b-instruct:free

# Model Configuration - Language Detection
LANG_DETECT_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Model Configuration - RAG Embeddings
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# Model Configuration - OCR
OCR_MODEL=baidu/qianfan-ocr-fast:free
OCR_USE_OPENROUTER=true
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# Legacy Agent Configuration (kept for backward compatibility)
OPENROUTER_PRIMARY_MODEL=nousresearch/hermes-3-llama-3.1-405b:free
OPENROUTER_MONITOR_MODEL=qwen/qwen3-next-80b-a3b-instruct:free

# Agent Settings
AGENT_MONITORING_ENABLED=false
AGENT_LLM_TIMEOUT_MS=30000
AGENT_MAX_TOOL_CALLS=3
AGENT_WEBHOOK_TIMEOUT_MS=10000
AGENT_ALLOW_EMERGENCY_WEBHOOK=false
EMERGENCY_SUPPORT_WEBHOOK_URL=
EMERGENCY_CONTACT_WEBHOOK_URL=
